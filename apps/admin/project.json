{
  "name": "admin",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "admin",
  "sourceRoot": "apps/admin/src",
  "tags": ["scope:admin", "type:app"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/admin",
        "browser": "apps/admin/src/main.ts",
        "polyfills": ["zone.js"],
        "tsConfig": "apps/admin/tsconfig.app.json",
        "assets": [{ "glob": "**/*", "input": "apps/admin/public" }],
        "styles": ["apps/admin/src/styles.scss"]
      },
      "configurations": {
        "production": {
          "budgets": [
            { "type": "initial", "maximumWarning": "500kb", "maximumError": "2mb" }
          ],
          "outputHashing": "all",
          "fileReplacements": [
            { "replace": "apps/admin/src/environments/environment.ts", "with": "apps/admin/src/environments/environment.prod.ts" }
          ]
        },
        "development": { "optimization": false, "sourceMap": true }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "configurations": {
        "production": { "buildTarget": "admin:build:production" },
        "development": { "buildTarget": "admin:build:development" }
      },
      "defaultConfiguration": "development"
    },
    "lint": { "executor": "@nx/eslint:lint" }
  }
}
