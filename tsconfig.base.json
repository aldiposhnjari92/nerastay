{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "esnext",
    "lib": ["ES2022", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "strict": true,
    "paths": {
      "@nerastay/shared": ["libs/shared/src/index.ts"],
      "@nerastay/auth": ["libs/auth/src/index.ts"],
      "@nerastay/ui": ["libs/ui/src/index.ts"],
      "@nerastay/map": ["libs/map/src/index.ts"],
      "@nerastay/listings": ["libs/listings/src/index.ts"],
      "@nerastay/booking": ["libs/booking/src/index.ts"],
      "@nerastay/reviews": ["libs/reviews/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
